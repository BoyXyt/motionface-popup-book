{
  "name": "motionface-popup-replica",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion v4 scaffold replicating the MotionFace popup book scene",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts PopupBook out/video.mp4",
    "still": "remotion still src/index.ts PopupBook out/still.png",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "@remotion/renderer": "4.0.547",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
